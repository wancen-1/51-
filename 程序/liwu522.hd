<xml xmlns="http://www.w3.org/1999/xhtml"><block type="setup" id="FZ;QNouPm+Ydel/bulm8" x="-795" y="-177"><statement name="DO"><block type="asr_speak_ShrimpBrotherVoice" id=",e-RP#m`)TfYh^d:1dfy"><field name="VOICE_SET_SHRIMPBROTHERVOICE">广州德哥-广东口音男声</field><field name="vol">6</field><field name="speed">10</field><next><block type="asr_welcom" id=")3`e*f)~4i4wI?[QymJY"><field name="NAME">你好，我是湾仔</field><next><block type="set_state_enter_wakeup" id="}9[Y5p41Q@Beld}1cN5*"><value name="num"><shadow type="math_number" id="gRZA{xAdKbg9{R4FXT./"><field name="NUM">5</field></shadow></value><next><block type="asr_sleep" id="T/2u}Q$vc/$/dkOG~rov"><field name="NAME">下次再见</field><next><block type="asr_id" id="z;IHE4P.32Y=Pe:PfICo"><field name="ASR">湾仔</field><field name="leibie">唤醒词</field><field name="huifu">我在</field><field name="id">0</field><next><block type="asr_id" id="WGh,bSr^sIm$aEQgotZ^"><field name="ASR">播放音乐</field><field name="leibie">命令词</field><field name="huifu">好的，为你播放我和我的祖国</field><field name="id">1</field><next><block type="asr_id" id=".Xid,q-ElB,i-!WiaE6G"><field name="ASR">来首劲爆的音乐</field><field name="leibie">命令词</field><field name="huifu">好的，为你播放小半</field><field name="id">2</field><next><block type="asr_id" id="cc!Lf/8rZO]d?NQj`mm/"><field name="ASR">打开灯光</field><field name="leibie">命令词</field><field name="huifu">灯光开启成功，柔和光线为你铺满</field><field name="id">3</field><next><block type="asr_id" id="[b1S-KiFZt*XoVSPrCw4"><field name="ASR">关闭灯光</field><field name="leibie">命令词</field><field name="huifu">灯光已成功关闭，愿你享受最好</field><field name="id">4</field><next><block type="asr_id" id="^J+)oJWT:/ufz4I7:pZD"><field name="ASR">打开电扇</field><field name="leibie">命令词</field><field name="huifu">我开了风扇啦，要是你觉得风大或者冷，随时跟我说</field><field name="id">5</field><next><block type="asr_id" id="iGCFZo,4=V3q__83|N@f"><field name="ASR">关闭电扇</field><field name="leibie">命令词</field><field name="huifu">风扇已经关掉咯，要是你还觉得热，随时跟我说哈</field><field name="id">6</field><next><block type="asr_id" id="6Cmd+P#_Q^d5r_LrktQr"><field name="ASR">音量大一点</field><field name="leibie">命令词</field><field name="huifu">当前音量调整到</field><field name="id">7</field><next><block type="asr_id" id="8fbTew5*vCZ$3C8lRZBl"><field name="ASR">音量在大一点</field><field name="leibie">命令词</field><field name="huifu">当前音量调整到</field><field name="id">8</field><next><block type="asr_id" id="b{j6[I!mYEG:!rq[]u0T"><field name="ASR">音量小一点</field><field name="leibie">命令词</field><field name="huifu">当前音量调整到</field><field name="id">9</field><next><block type="asr_id" id="8Bn^~r~Z.xO[9l``3J70"><field name="ASR">音量在小一点</field><field name="leibie">命令词</field><field name="huifu">当前音量调整到</field><field name="id">10</field><next><block type="asr_id" id="Ufa2cjG2LG?6K~ib=/EW"><field name="ASR">把电扇调到一档</field><field name="leibie">命令词</field><field name="huifu">已调整的一档</field><field name="id">11</field><next><block type="asr_id" id="w$nSTAD!y3dWmXFl1J%T"><field name="ASR">把电扇调到二档</field><field name="leibie">命令词</field><field name="huifu">已调整的二档</field><field name="id">12</field><next><block type="asr_id" id="sJO9O|sX=1}H5{zz0m{w"><field name="ASR">把电扇调到三档</field><field name="leibie">命令词</field><field name="huifu">已调整的三档</field><field name="id">13</field><next><block type="asr_id" id="F%S.?5ZS3i_I:1vMcR^W"><field name="ASR">立正</field><field name="leibie">命令词</field><field name="huifu">好滴鸭</field><field name="id">14</field><next><block type="asr_id" id="7b:VNb1Mq#-/N~k60%X/"><field name="ASR">休眠</field><field name="leibie">命令词</field><field name="huifu">那我睡觉咯</field><field name="id">15</field><next><block type="asr_id" id="ZP)B-wwc3dr=#Pikr-D."><field name="ASR">蹲下</field><field name="leibie">命令词</field><field name="huifu">你让蹲我就蹲，那我岂不是很没面子</field><field name="id">16</field><next><block type="asr_id" id="IC;)zBj4O[aLzCv;^.Do"><field name="ASR">低头</field><field name="leibie">命令词</field><field name="huifu">哪儿有钱，没看到呀</field><field name="id">17</field><next><block type="asr_id" id="Z|*e$?QS/kbffvy^KYT8"><field name="ASR">握手</field><field name="leibie">命令词</field><field name="huifu">你好呀，我是湾仔，你叫什么名字</field><field name="id">18</field><next><block type="asr_id" id="Yuz{g7RgPLVYx8*OZ{nj"><field name="ASR">背诵校训</field><field name="leibie">命令词</field><field name="huifu">豌豆课堂，进则科技特长，退则数理化强</field><field name="id">19</field><next><block type="asr_id" id="t*BZrKu=]Mm_wXegIgFh"><field name="ASR">趴下</field><field name="leibie">命令词</field><field name="huifu">这样也不错，挺舒服</field><field name="id">20</field><next><block type="asr_id" id="9BETRN,}RFj_)Z*Ln*9`"><field name="ASR">伸懒腰</field><field name="leibie">命令词</field><field name="huifu">咿呀，好舒服呀</field><field name="id">21</field><next><block type="asr_id" id="17V2t?LJ#{jVs}D6,Iq8"><field name="ASR">你能干嘛</field><field name="leibie">命令词</field><field name="huifu">我能开灯，关灯，开电扇，关电扇，播放音乐，调节声音，背诵校训、伸懒腰。</field><field name="id">22</field><next><block type="asr_id" id="pmMbrNzJmp%r.uxlEeKx"><field name="ASR">怎么调节音量</field><field name="leibie">命令词</field><field name="huifu">你可以说最小音量或者中等音量或者最大音量</field><field name="id">23</field></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="asr_volume_settings" id="o7GD_}EH6R#n:dn_J6YT" x="126" y="-200"><field name="CHINESE_STATE">TRUE</field><field name="ENGLISH_STATE">FALSE</field><field name="vol_max">音量调整到最大</field><field name="vol_max_rsp">当前音量调整到最大</field><field name="vol_med">音量调整到最中</field><field name="vol_med_rsp">当前音量调整到中等</field><field name="vol_min">音量调整到最小</field><field name="vol_min_rsp">当前音量调整到最小</field></block><block type="hardware_init" id="{k6NJeV5Fo4|[{.@6t9D" x="137" y="-26"><statement name="DO"><block type="serial_begin" id="s0nOKj