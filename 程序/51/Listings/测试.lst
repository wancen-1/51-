 140          // 超声波测距函数（优化：避免阻塞主程序）
 141          u16 GetDistance(void) {
 142   1          u16 time = 0;
 143   1          u16 distance = 0;
 144   1      
 145   1          // 发送10us触发信号
 146   1          Trig = 1;
 147   1          Delay10us();
 148   1          Trig = 0;
 149   1      
 150   1          // 等待Echo上升沿（开始接收回波）
 151   1          while (Echo == 0 && time < 1000);  // 超时保护，避免死等
 152   1          if (time >= 1000) return 0;        // 超时返回0（无效距离）
 153   1      
 154   1          // 计时Echo高电平时间（使用定时器0计数，不阻塞）
 155   1          TR0 = 1;  // 启动定时器0计时
 156   1          while (Echo == 1 && time < 60000); // 超时保护（最大测量距离约10m）
 157   1          TR0 = 0;  // 停止定时器0
 158   1      
 159   1          // 计算时间（定时器0计数次数 = TH0*256 + TL0）
 160   1          time = TH0 * 256 + TL0;
 161   1          TH0 = 0;  // 清空定时器0
 162   1          TL0 = 0;
 163   1      
 164   1          // 计算距离：距离(cm) = 时间(us) * 声速(340m/s) / 2 / 10000
 165   1          distance = time * 0.17;
 166   1          return distance;
 167   1      }
