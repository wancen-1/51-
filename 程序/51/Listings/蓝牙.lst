   1          #include <reg52.h>
   2          
   3          typedef unsigned char uchar;
   4          typedef unsigned int uint;
   5          
   6          sbit Relay = P1^0;  // 继电器控制引脚
   7          
   8          // 串口初始化（9600波特率，晶振11.0592MHz）
   9          void UART_Init() {
  10   1          TMOD |= 0x20;    // 定时器1工作模式2（8位自动重装）
  11   1          TH1 = 0xFD;      // 9600波特率初值
  12   1          TL1 = 0xFD;
  13   1          TR1 = 1;         // 启动定时器1
  14   1          SCON = 0x50;     // 串口工作模式1，允许接收
  15   1          EA = 1;          // 开总中断
  16   1          ES = 1;          // 开串口中断
  17   1      }
  18          
  19          // 风扇控制函数
  20          void Fan_Control(uchar cmd) {
  21   1          switch(cmd) {
  22   2              case 01:    // 简化指令：'1'启动
  23   2                  Relay = 1;
  24   2                  break;
  25   2              case 00:    // 简化指令：'0'停止
  26   2                  Relay = 0;
  27   2                  break;
  28   2              default:
  29   2                  break;
  30   2          }
  31   1      }
  32          
  33          // 串口中断服务函数（支持单字符或字符串指令）
  34          void UART_ISR() interrupt 4 {
  35   1          int rec_data;
  36   1          
  37   1          if(RI) {         // 接收中断标志
  38   2              RI = 0;      // 清标志
  39   2              rec_data = SBUF;
  40   2              
  41   2              // 单字符指令处理
  42   2                  Fan_Control(rec_data);
  43   2      
  44   2              }
  45   1      }
  46          
  47          void main() {
  48   1          UART_Init();     // 初始化串口
  49   1          Relay = 0;       // 初始状态：风扇关闭
  50   1          while(1);        // 主循环
  51   1      }


