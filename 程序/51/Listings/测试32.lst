 242          // ==================== 串口指令处理（无长延时）====================
 243          void UART_Cmd_Process() {
 244   1          if (!uart_cmd_flag) return; // 无指令则返回
 245   1          
 246   1          switch(uart_cmd) {
 247   2              case 0x34: // 正转（3档）
 248   2                  duty_cycle = GEAR3_DUTY;
 249   2                  current_gear = 3;
 250   2                  lcd_show_char('3');
 251   2                  break;
 252   2              case 0x35: // 停止
 253   2                  duty_cycle = 0;
 254   2                  current_gear = 0;
 255   2                  lcd_show_char('0');
 256   2                  break;
 257   2              case 0x33: // LED流水灯开启
 258   2                  led_flow_flag = 1;
 259   2                  led_flow_cnt = 0;
 260   2                  break;
 261   2              case 0x32: // LED流水灯关闭
 262   2                  led_flow_flag = 0;
 263   2                  P2 = 0xff; // 关闭所有LED
 264   2                  break;
 265   2              case 0x36: // 1档
 266   2                  duty_cycle = GEAR1_DUTY;
 267   2                  current_gear = 1;
 268   2                  lcd_show_char('1');
 269   2                  break;
 270   2              case 0x37: // 2档
 271   2                  duty_cycle = GEAR2_DUTY;
 272   2                  current_gear = 2;
 273   2                  lcd_show_char('2');
 274   2                  break;
 275   2              case 0x38: // 3档
 276   2                  duty_cycle = GEAR3_DUTY;
 277   2                  current_gear = 3;
 278   2                  lcd_show_char('3');
 279   2                  break;
 280   2          }
 281   1          uart_cmd_flag = 0; // 清标记
 282   1          uart_cmd = 0;      // 清指令
 283   1      }
 284          
 285          // ==================== LED流水灯（非阻塞）====================
 286          void LED_Flow_Process() {
 287   1          static unsigned char flow_i;
 288   1          if (!led_flow_flag) return;
 289   1          
 290   1          led_flow_cnt++;
 291   1          if (led_flow_cnt >= 300) { // 每300ms刷新一次（非阻塞）
 292   2              led_flow_cnt = 0;
 293   2              flow_i = 0;
 294   2              P2 = 0x7f >> flow_i;
 295   2              flow_i++;
 296   2              if (flow_i >= 7) flow_i = 0;
 297   2          }
 298   1      }
