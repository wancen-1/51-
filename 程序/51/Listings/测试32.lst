 117          u16 GetDistance() {
 118   1          unsigned int timeout;
 119   1          u16 time = 0;
 120   1          u16 distance = 0;
 121   1      
 122   1          Trig = 1;
 123   1          Delay10us();
 124   1          Trig = 0;
 125   1      
 126   1          // 等待Echo上升沿（超时保护）
 127   1          
 128   1          timeout = 0;
 129   1          while (Echo == 0) {
 130   2              timeout++;
 131   2              if (timeout > 1000) return 999; // 超时返回无效值
 132   2          }
 133   1      
 134   1          // 计时Echo高电平（超时保护）
 135   1          timeout = 0;
 136   1          while (Echo == 1) {
 137   2              time++;
 138   2              Delay10us();
 139   2              timeout++;
 140   2              if (timeout > 60000) break;
 141   2          }
 142   1      
 143   1          distance = time * 0.17;
 144   1          return distance;
 145   1      }
