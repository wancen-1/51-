   1          #include <reg52.h>
   2          
   3          // 定义引脚
   4          sbit in_d = P1^0; // PWM输出引脚
   5          sbit KEY1 = P3^1;    // 挡位1按键
   6          sbit KEY2 = P3^0;    // 挡位2按键
   7          sbit KEY3 = P3^2;    // 挡位3按键
   8          
   9          // 数码管引脚定义（1位共阴极数码管）
  10          #define DIGIT_PORT P0 // 段选端口
  11          sbit DIGIT_SEL = P2^0; // 位选端口（若多位可扩展）
  12          
  13          // 定义PWM参数（周期=100μs，频率=10kHz）
  14          #define PWM_PERIOD 100  // PWM周期（定时器计数次数）
  15          unsigned char duty_cycle = 0; // 占空比（0~PWM_PERIOD）
  16          unsigned char current_gear = 0; // 当前挡位（0~3，0为停止）
  17          
  18          // 挡位占空比配置（可根据实际需求调整）
  19          #define GEAR1_DUTY 50   // 挡位2：50%占空比（中低速）
  20          #define GEAR2_DUTY 75   // 挡位3：75%占空比（中高速）
  21          #define GEAR3_DUTY 100  // 挡位4：100%占空比（高速）
  22          
  23          // 共阴极数码管段码表（0~9）
  24          unsigned char code digit_table[] = {
  25              0x3F, // 0
  26              0x06, // 1
  27              0x5B, // 2
  28              0x4F, // 3
  29              0x66, // 4
  30              0x6D, // 5
  31              0x7D, // 6
  32              0x07, // 7
  33              0x7F, // 8
  34              0x6F  // 9
