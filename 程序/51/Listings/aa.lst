  55          // 定时器1中断服务函数（PWM生成）
  56          void Timer1_ISR(void) interrupt 3 {
  57   1          static unsigned char count = 0;
  58   1          TH1 = (65536 - PWM_PERIOD) / 256;  // 重装初值
  59   1          TL1 = (65536 - PWM_PERIOD) % 256;
  60   1          
  61   1          count++;
  62   1          if (count <= duty_cycle) {
  63   2              in_d = 1;  // 高电平
  64   2          } else {
  65   2              in_d = 0;  // 低电平
  66   2          }
  67   1          if (count >= PWM_PERIOD) {
  68   2              count = 0;    // 周期结束，重置计数
  69   2          }
  70   1      }
  71          
  72          // 数码管显示函数（显示当前挡位）
  73          void Display_Gear(void) {
  74   1          DIGIT_PORT = digit_table[current_gear]; // 输出段码
  75   1          DIGIT_SEL = 0; // 选中数码管（共阴极位选低电平有效，若为共阳极需改为1）
  76   1      }
  77          
  78          // 按键检测函数（消抖处理）
  79          void Key_Scan(void) {
  80   1          // 检测挡位2按键
  81   1          if (KEY1 == 0) {
  82   2              delay(20);
  83   2              if (KEY1 == 0) {
  84   3                  duty_cycle = GEAR1_DUTY;
  85   3                  current_gear = 1;
  86   3                  while (!KEY1);
  87   3              }
  88   2          }
  89   1          // 检测挡位3按键
  90   1          if (KEY2 == 0) {
  91   2              delay(20);
  92   2              if (KEY2 == 0) {
  93   3                  duty_cycle = GEAR2_DUTY;
  94   3                  current_gear = 2;
  95   3                  while (!KEY2);
  96   3              }
  97   2          }
  98   1          // 检测挡位4按键
  99   1          if (KEY3 == 0) {
 100   2              delay(20);
 101   2              if (KEY3 == 0) {
 102   3                  duty_cycle = GEAR3_DUTY;
 103   3                  current_gear = 3;
 104   3                  while (!KEY3);
 105   3              }
 106   2          }
 107   1      }
