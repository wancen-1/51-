  37          // 延时函数（简单延时，可根据实际调整）
  38          void delay(unsigned int time) {
  39   1          unsigned int i, j;
  40   1          for (i = time; i > 0; i--)
  41   1              for (j = 110; j > 0; j--);
  42   1      }
  43          
  44          // 定时器1初始化（产生PWM信号）
  45          void Timer1_Init(void) {
  46   1          TMOD &= 0x0F;  // 清空定时器1模式
  47   1          TMOD |= 0x10;  // 定时器1工作模式1（16位自动重装）
  48   1          TH1 = (65536 - PWM_PERIOD) / 256;  // 初值高8位
  49   1          TL1 = (65536 - PWM_PERIOD) % 256;  // 初值低8位
  50   1          ET1 = 1;       // 使能定时器1中断
  51   1          TR1 = 1;       // 启动定时器1
  52   1          EA = 1;        // 开启总中断
  53   1      }
  54          
