  13          // 数码管引脚定义（1位共阴极数码管）
  14          #define DIGIT_PORT P0 // 段选端口
  15          sbit DIGIT_SEL = P2^1; // 位选端口（若多位可扩展）
  16          
  17          // 定义PWM参数（周期=100μs，频率=10kHz）
  18          #define PWM_PERIOD 100  // PWM周期（定时器计数次数）
  19          unsigned char duty_cycle = 0; // 占空比（0~PWM_PERIOD）
  20          unsigned char current_gear = 0; // 当前挡位（0~3，0为停止）
  21          
  22          // 挡位占空比配置（可根据实际需求调整）
  23          #define GEAR1_DUTY 50   // 挡位2：50%占空比（中低速）
  24          #define GEAR2_DUTY 75   // 挡位3：75%占空比（中高速）
  25          #define GEAR3_DUTY 100  // 挡位4：100%占空比（高速）
