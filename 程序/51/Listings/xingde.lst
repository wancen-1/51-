  30          // 共阴极数码管段码表（0~9）
  31          unsigned char code digit_table[] = {0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07,0x7F,0x6F};
  32          
  33          void Timer1_Init(void) {
  34   1          TMOD &= 0xF0;  // 清空定时器1模式
  35   1          TMOD |= 0x01;  // 定时器1工作模式1（16位自动重装）
  36   1          TH0 = (65536 - PWM_PERIOD) / 256;  // 初值高8位
  37   1          TL0 = (65536 - PWM_PERIOD) % 256;  // 初值低8位
  38   1          ET0 = 1;       // 使能定时器1中断
  39   1          TR0 = 1;       // 启动定时器1
  40   1          EA = 1;        // 开启总中断
  41   1      }
  42          
  43          // 定时器1中断服务函数（PWM生成）电机的快慢
  44          void Timer1_ISR(void) interrupt 1 {
  45   1          static unsigned char count = 0;
  46   1          TH0 = (65536 - PWM_PERIOD) / 256;  // 重装初值
  47   1          TL0 = (65536 - PWM_PERIOD) % 256;
  48   1          
  49   1          count++;
  50   1          if (count <= duty_cycle) {
  51   2              in_d = 1;  // 高电平
  52   2          } else {
  53   2              in_d = 0;  // 低电平
  54   2          }
C51 COMPILER V9.60.7.0   XINGDE                                                            01/06/2026 14:15:12 PAGE 2   

  55   1          if (count >= PWM_PERIOD) {
  56   2              count = 0;    // 周期结束，重置计数
  57   2          }
  58   1      }
  59          
  60          //语音模块配置接口
  61          void UART_Init()
  62          {
  63   1        
  64   1        SCON = 0x50;//配置串口的通信方式
  65   1        TMOD &= 0x0F;
  66   1        TMOD |= 0x20;
  67   1        TH1 = 256 - (11059200 / 12 / 32) / 9600;//装载需要计算
  68   1        TL1 = TH1;
  69   1        TR1 = 1;
  70   1        ES = 1;
  71   1      //  PS=1;
  72   1        EA = 1;
  73   1      }
  74          
  75          //微秒
  76          void Delay10us() {
  77   1          unsigned char i;
  78   1          i = 2;
  79   1          while (--i);
  80   1      }
  81          
  82          void delay()
  83          {
  84   1        _nop_();
  85   1        _nop_();
  86   1        _nop_();
  87   1      }
  88          // 毫秒级延时（用于主循环间隔）
  89          void DelayMs(unsigned int ms) 
  90          {
  91   1          unsigned int i, j;
  92   1          for (i = ms; i > 0; i--)
  93   1              for (j = 110; j > 0; j--);
  94   1      }
  95          
  96          // 数码管显示函数（显示当前挡位）
  97          void Display_Gear(void) 
  98          {
  99   1          DIGIT_PORT = digit_table[current_gear]; // 输出段码
 100   1          DIGIT_SEL = 0; // 选中数码管（共阴极位选低电平有效，若为共阳极需改为1）
 101   1          DelayMs(1);
 102   1      }
