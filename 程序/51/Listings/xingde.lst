 129          void lcd_w_cmd(unsigned char com)//写命令
 130          {
 131   1        DelayMs(1);
 132   1        RS=0;
 133   1        delay();
 134   1        RW=0;
 135   1        delay();
 136   1        E=1;
 137   1        delay();
 138   1        P0=com;
 139   1        delay();
 140   1        E=0;
 141   1        delay();
 142   1        RW=1;
 143   1        DelayMs(1);
 144   1      }
 145          
 146          void lcd_w_dat(unsigned char dat)//写数据
 147          {
 148   1        DelayMs(1);
 149   1        RS=1;
 150   1        delay();
 151   1        RW=0;
 152   1        delay();
 153   1        E=1;
 154   1        delay();
 155   1        P0=dat;
 156   1        delay();
 157   1        E=0;
 158   1        delay();
 159   1        RW=1;
 160   1        DelayMs(1);  // 修正：delayms -> delaysms
 161   1      }
 162          
 163          void lcd_init()  // 初始化函数名
 164          {
 165   1       lcd_w_cmd(0x38);  // 改为5×8点阵，更通用
 166   1       lcd_w_cmd(0x0c);  // 开显示+显示光标
 167   1       lcd_w_cmd(0x01);  // 清屏
 168   1       lcd_w_cmd(0x06);  // 光标右移，整屏不移动
 169   1       lcd_w_cmd(0x80);  // 光标定位到第一行第1列
 170   1      }
 171          
 172          void lcd_1(unsigned char *a)
 173          {
 174   1        //unsigned char lcd2[]="???!";
 175   1        P0=0xff;
 176   1        DelayMs(1);
 177   1        lcd_w_cmd(0x83);// 光标定位到第一行第4列
