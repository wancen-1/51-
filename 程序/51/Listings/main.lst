  35          void Timer1_Init(void) {
  36   1          TMOD &= 0xF0;  // 清空定时器1模式
  37   1          TMOD |= 0x01;  // 定时器1工作模式1（16位自动重装）
  38   1          TH0 = (65536 - PWM_PERIOD) / 256;  // 初值高8位
  39   1          TL0 = (65536 - PWM_PERIOD) % 256;  // 初值低8位
  40   1          ET0 = 1;       // 使能定时器1中断
  41   1          TR0 = 1;       // 启动定时器1
  42   1          EA = 1;        // 开启总中断
  43   1      }
  44          
  45          // 定时器1中断服务函数（PWM生成）电机的快慢
  46          void Timer1_ISR(void) interrupt 1 {
  47   1          static unsigned char count = 0;
  48   1          TH0 = (65536 - PWM_PERIOD) / 256;  // 重装初值
  49   1          TL0 = (65536 - PWM_PERIOD) % 256;
  50   1          
  51   1          count++;
  52   1          if (count <= duty_cycle) {
  53   2              in_d = 1;  // 高电平
  54   2          } else {
C51 COMPILER V9.60.7.0   MAIN                                                              12/25/2025 13:09:31 PAGE 2   

  55   2              in_d = 0;  // 低电平
  56   2          }
  57   1          if (count >= PWM_PERIOD) {
  58   2              count = 0;    // 周期结束，重置计数
  59   2          }
  60   1      }
