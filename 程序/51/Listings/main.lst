 106          // 测量距离并返回（单位：cm）
 107          unsigned int GetDistance() 
 108          {
 109   1          unsigned int time = 0;
 110   1          unsigned int distance = 0;
 111   1      
 112   1          // 发送触发信号：10us高电平
 113   1          Trig = 1;
 114   1          Delay10us();
 115   1          Trig = 0;
 116   1      
C51 COMPILER V9.60.7.0   MAIN                                                              12/25/2025 13:09:31 PAGE 3   

 117   1          // 等待Echo上升沿（开始接收回波）
 118   1          while (Echo == 0);
 119   1          // 计时Echo高电平持续时间（回波接收时间）
 120   1          while (Echo == 1) {
 121   2              time++;
 122   2              Delay10us();
 123   2              if (time > 60000) break; // 超时保护，避免死循环
 124   2          }
 125   1      
 126   1          // 计算距离：距离(cm) = 时间(us) * 声速(340m/s) / 2 / 10000
 127   1          distance = time * 0.17;
 128   1          return distance;
 129   1      }
